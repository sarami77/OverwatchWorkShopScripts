rule: "TestOngoingGlobal"
Event.OngoingGlobal
{
    DisableInspectorRecording();
    Wait(3);
    define initBot = false;


    while(true){
        if(
            !initBot ||
            IsTrueEverySeconds(180)
        ){
            initBot = true;
            DestroyBots(humanTeam);
            DestroyBots(enemyTeam);
            CreateBotsByAsset(asset[0], humanTeam, 0);
            CreateBotsByAsset(asset[0], enemyTeam, 1);
            SetRespawnMaxTime(ap(ta), 0);
            // SetMaxHealth(ap(ta), 500);
            // Heal(ap(ta), null, MaxValue());
            // SetStatus(ap(ta), null, Status.Unkillable, MaxValue() );
            AllPlayers().watchUpdateRate = 1;
            AllPlayers().isBotActive = true;
            HostPlayer().isBotActive = false;
        }

        define player = GetPlayerMinChebyshevDistance(hp, AllLivingPlayers(EnemyTeamOf(hp)));
        // dbgHudTxt(<"player = <0>", player>);
        // dbgPlyBemEft(hp, player);

        Wait(0.2);
    }
}


define bombScale : 
    tuneVal == EnemyType.Minion * 0.01 ?     1 :
    tuneVal == EnemyType.Elite * 0.01 ?      2 :
    tuneVal == EnemyType.SubBoss * 0.01 ?    4 :
    tuneVal == EnemyType.Boss * 0.01 ?       4 :
    0;
define bombCountDownInterval:       0.3 + (0.15 * bombScale);
define bombSize:                    bombScale * 0.4;
define bombExplodeRange:            2  + (bombScale * 3.0);
define bombExplodeDamage:           50 + (bombScale * 100);
define bombBunrningDamagePS:        25;
define bombBunrningSecond:          1 + (bombScale * 1.5);

