// TAG HeroMod_Action_ARTILLERY
enum ARTILLERY_MODE{
    SUPPORT,
    REQUEST
}

void HeroMod_Action_ARTILLERY(define targetMode!) playervar "HeroMod_Action_ARTILLERY" {
    Wait(0.5, WaitBehavior.IgnoreCondition);

    // config value
    define artilleryAttackInterval! = 0.2;
    define attackCount = targetMode == ARTILLERY_MODE.SUPPORT ? 200 : 400;
    define artilleryScatterRange! = targetMode == ARTILLERY_MODE.SUPPORT ? 10.0 : 5.0;
    define artilleryDamageRange! = 5.0;
    define artilleryDamage! = 100;

    // create shell
    define deployPosition = PositionOf(ep) + (VectorWithOutY(RandomDirection()) * 40) + (Up() * 80);
    define landPosition1;
    define landPosition2;
    define shellPosition1;
    define shellPosition2;
    define shellEffect1! = CreateEffect(AllPlayers(), Effect.Orb,
        Color.White,
        shellPosition1,
        1, EffectRev.PositionAndRadius
    );
    define shellEffect2! = CreateEffect(AllPlayers(), Effect.Orb,
        Color.White,
        shellPosition2,
        1, EffectRev.PositionAndRadius
    );

    // shell land and blast animation
    define basePosition;
    for(define count = 0; count < attackCount / 2; count ++){
        // update base positio by every 4 shot
        if(count % 4 == 0){
            // get base position
            basePosition =
                targetMode == ARTILLERY_MODE.SUPPORT ?
                PositionOf(ep) :
                AimingPosition(ActionRange.CanFind, EnemyTeamOf(ep));
            basePosition = BelowPosition(basePosition);
        }

        // start land animation1
        landPosition1 =
            basePosition + 
            RandomPosition(
                artilleryScatterRange,
                0,
                artilleryScatterRange
            );
        shellPosition1 = deployPosition;
        ChaseVariableOverTime(
            shellPosition1,
            landPosition1,
            artilleryAttackInterval * 2,
            TimeChaseReevaluation.None
        );
        
        Wait(artilleryAttackInterval, WaitBehavior.IgnoreCondition);

        
        if(count != 0)
            // start blast animation2
            DoExplosion(landPosition2, artilleryDamageRange, artilleryDamage);

        // start land animation2
        landPosition2 =
            basePosition + 
            RandomPosition(
                artilleryScatterRange,
                0,
                artilleryScatterRange
            );
        shellPosition2 = deployPosition;
        ChaseVariableOverTime(
            shellPosition2,
            landPosition2,
            artilleryAttackInterval * 2,
            TimeChaseReevaluation.None
        );

        Wait(artilleryAttackInterval, WaitBehavior.IgnoreCondition);
        
        // start blast animation1
        DoExplosion(landPosition1, artilleryDamageRange, artilleryDamage);
    }

    Wait(artilleryAttackInterval, WaitBehavior.IgnoreCondition);

    // final blast animation2
    // play blast sound
    DoExplosion(landPosition2, artilleryDamageRange, artilleryDamage);

    StopChasingVariable(shellPosition1);
    StopChasingVariable(shellPosition2);
    DestroyEffect(shellEffect1);
    DestroyEffect(shellEffect2);

    if(targetMode == ARTILLERY_MODE.REQUEST){
        SetUltimateCharge(ep, 0);
    }
}

void DoExplosion(define pos, define range, define damage)"DoExplosion"{
        // play blast sound
        PlayEffect(
            AllPlayers(), PlayEffect.RingExplosionSound,
            Color .White,
            pos,
            MaxLength());
        // play blast
        PlayEffect(
            AllPlayers(), PlayEffect.GoodExplosion,
            Color.Orange,
            pos,
            range);
        // damage
        Damage(
            PlayersWithinRadius(
                pos, range,
                EnemyTeamOf(ep), RadiusLOS.Off
            ),
            ep, damage
        );
}

// TAG KillCount -----------------------------------------------
globalvar define killCountTeam1;
globalvar define killCountTeam2;

rule: "killCount/countUp"
Event.OnFinalBlow
{
    if(TeamOf() == Team.Team1)
        killCountTeam1 ++;
    else if(TeamOf() == Team.Team2)        
        killCountTeam2 ++;
}

// TAG Debug ----------
globalvar define dbgCntA!;
globalvar define dbgCntB!;
globalvar define debugHuds!;

define Last():
    CountOf(debugHuds);

define AimingPositonOf(define player):
    RayCastHitPosition(
        EyePosition(player),
        EyePosition(player) +
            (FacingDirectionOf(player) * MaxLength()),
        null,
        null,
        false
    );

rule: "showParam"
Event.OngoingGlobal
{
        wm(); debugHuds[Last()] = CreateDebugHud(
            "Server Load", ServerLoad(), 
            ServerLoad()            >= ServerLoad.FULL ?    Color.Red :
            ServerLoad()            >= ServerLoad.HIGH ?    Color.Yellow:
                                                            Color.Gray);
    wm(); debugHuds[Last()] = CreateDebugHud("Count Action Wait", countActionWait, Color.Gray);
    wm(); debugHuds[Last()] = CreateDebugHud("Game Speed", gameSpeed, gameSpeed < gameSpeedMax ? Color.Yellow : Color.Gray);
    wm(); debugHuds[Last()] = CreateDebugHud("Count Game Speed Decrease", countGameSpeedDecrease, countGameSpeedDecrease > 0 ? Color.Yellow : Color.Gray);
    wm(); debugHuds[Last()] = CreateDebugHud("player team player num", <"<0> / <1>", NumberOfLivingPlayers(humanTeam), NumberOfPlayers(humanTeam)>, Color.Team1);
    wm(); debugHuds[Last()] = CreateDebugHud("enemy team player num", <"<0> / <1>", NumberOfLivingPlayers(enemyTeam), NumberOfPlayers(enemyTeam)>, Color.Team2);
    wm(); debugHuds[Last()] = CreateDebugHud("killCountTeam1", killCountTeam1, Color.Team1);
    wm(); debugHuds[Last()] = CreateDebugHud("killCountTeam2", killCountTeam2, Color.Team2);
    wm(); debugHuds[Last()] = CreateDebugHud("tune Val", tuneVal, Color.Orange);
    wm(); debugHuds[Last()] = CreateDebugHud("Distance to aim pos", DistanceBetween(HostPlayer(), AimingPositonOf(HostPlayer())), Color.Orange);
    wm(); debugHuds[Last()] = CreateDebugHud("dbg Cnt A", dbgCntA, Color.Orange);
    wm(); debugHuds[Last()] = CreateDebugHud("dbg Cnt B", dbgCntB, Color.Orange);
}

