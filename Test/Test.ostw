// TAG BotTest -----------------------------------------------

define asset:
    [
        [
            // [EnemyType.Non,     Hero.Baptiste,    1],
            [EnemyType.Non,     Hero.Reinhardt,     1]
            // [EnemyType.Non,     Hero.Genji,     1],
            // [EnemyType.Non,     Hero.Wuyang,     1],
            // [EnemyType.Non,     Hero.Vendetta,      1],
            // [EnemyType.Non,     Hero.Ana,    1]
