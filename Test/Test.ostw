globalvar define serverLoadTotal;

rule: "TestOngoingGlobal"
Event.OngoingGlobal
{
    DisableInspectorRecording();
    Wait(3);
    define initBot = false;
    countActionWait = 0;

    while(true){
        if(
            !initBot ||
            IsTrueEverySeconds(180)
        ){
            initBot = true;
            DestroyBots(humanTeam);
            DestroyBots(enemyTeam);
            CreateBotsByAsset(asset[0], humanTeam, 12);
            CreateBotsByAsset(asset[1], enemyTeam, 12);
            SetRespawnMaxTime(ap(ta), 0);
            // SetMaxHealth(ap(ta), 500);
            // Heal(ap(ta), null, MaxValue());
            AllPlayers().watchUpdateRate = 1;
            AllPlayers().isBotActive = true;
            HostPlayer().isBotActive = false;
        }

        if(IsTrueEverySeconds(1)){



            // define idlePlayers = FilteredArray(AllPlayers(), 
            //     IsDummyBot(ae) && ae.actionState == ActionState.Non
            // );
            // for(define index! = 0; index < CountOf(idlePlayers); index++){
            //     ApplyImpulse(
            //         idlePlayers[index],
            //         DirectionTowards(idlePlayers[index], Vector(0, 5, 0)),
            //         DistanceBetween(idlePlayers[index], Vector(0, 5, 0)) * 1,
            //         Relative.ToWorld, ContraryMotion.Cancel
            //     );
            // }
            // SetAbilityCooldown(ap(ta), Button.Ability1, 0);
            // SetAbilityCooldown(ap(ta), Button.Ability2, 0);
            // SetUltimateCharge(ap(ta), 100);
            // SetStatus(ap(ta), null, Status.PhasedOut, 9999);
        }

        Wait(1);
    }
}


define bombScale : 
    tuneVal == EnemyType.Minion * 0.01 ?     1 :
    tuneVal == EnemyType.Elite * 0.01 ?      2 :
    tuneVal == EnemyType.SubBoss * 0.01 ?    4 :
    tuneVal == EnemyType.Boss * 0.01 ?       4 :
    0;
define bombCountDownInterval:       0.3 + (0.15 * bombScale);
define bombSize:                    bombScale * 0.4;
define bombExplodeRange:            2  + (bombScale * 3.0);
define bombExplodeDamage:           50 + (bombScale * 100);
define bombBunrningDamagePS:        25;
define bombBunrningSecond:          1 + (bombScale * 1.5);

rule: "TestOngoingPlayer"
Event.OngoingPlayer
if(
    IsButtonHeld(hp, Button.Melee)
){

            define bombPos! = PositionOf(NoPosition()) + Vector(0, 0.1, 0);
            define bombIcon! = CreateIcon(AllPlayers(humanTeam), bombPos, Icon.Warning, IconRev.VisibleToAndColor, cautionColor, true);
            define bombEfct! = CreateEffect(AllPlayers(), Effect.Sphere, cautionColor, bombPos, bombSize, EffectRev.Color);
            define bombEfctRing! = CreateEffect(AllPlayers(), Effect.Ring, cautionColor, bombPos, bombExplodeRange, EffectRev.Color);

            for(define index! = 0; index < 3; index++){
                PlayEffect(AllPlayers(), PlayEffect.DebuffImpactSound, null, bombPos, 75);
                for(define index2! = 0; index2 < 3; index2++){
                    PlayEffect(AllPlayers(), PlayEffect.BadExplosion, Color.White, bombPos, bombSize * 0.75);
                    Wait(bombCountDownInterval / 3, WaitBehavior.IgnoreCondition);
                }
            }

            DestroyIcon(bombIcon);
            DestroyEffect(bombEfct);
            DestroyEffect(bombEfctRing);

            define targets! = PlayersWithinRadius(bombPos, bombExplodeRange, Team.All, RadiusLOS.SurfacesAndAllBarriers);
            SetStatus(targets, ep, Status.Burning, bombBunrningSecond);
            ApplyBlastImpulse(targets, bombPos, bombExplodeRange, 3);
            Damage(targets, ep, bombExplodeDamage);
            StartDamageOverTime(targets, ep, bombBunrningSecond, bombBunrningDamagePS);
            PlayContinuousBlast(Color.Red, bombPos, bombExplodeRange, bombScale * 1.5, bombScale * 1.5);

}

// TAG EnemyBot/CautionColor ----------
define cautionColor: isBlink ? Color.Red : Color.Yellow;

globalvar define isBlink;

rule: "EnemyBot/CautionColor/blinkColor"
Event.OngoingGlobal
if(
    true
){
    while(true){
        isBlink = !isBlink;
        Wait(0.15, WaitBehavior.AbortWhenFalse);
    }
}


// TAG Round -----------------------------------------------
rule: "Round/shortenAssemblePhase"
Event.OngoingGlobal
if(
    IsAssemblingHeroes()
){
    SetMatchTime(3);
}

rule: "Round/shortenSetupPhase"
Event.OngoingGlobal
if(
    IsInSetup()
){
    SetMatchTime(3);
}

// TAG KillCount -----------------------------------------------
globalvar define killCountTeam1;
globalvar define killCountTeam2;

rule: "killCount/countUp"
Event.OnFinalBlow
{
    if(TeamOf() == Team.Team1)
        killCountTeam1 ++;
    else if(TeamOf() == Team.Team2)        
        killCountTeam2 ++;
}

// TAG TeamFormation -----------------------------------------------
rule: "TeamFormation/restart"
Event.OngoingGlobal
{
    return;

    while(true){
        WaitUntil(
            (
                NumberOfLivingPlayers(humanTeam) <= 0 ||
                NumberOfLivingPlayers(enemyTeam)  <= 0
            ),
            MaxValue()
        );
        Wait(3);
        Respawn(ap(Team.All));
        Wait(1);
    }
}


// TAG Debug ----------
globalvar define dbgCntA!;
globalvar define dbgCntB!;
globalvar define debugHuds!;

define Last():
    CountOf(debugHuds);

define AimingPositonOf(define player):
    RayCastHitPosition(
        EyePosition(player),
        EyePosition(player) +
            (FacingDirectionOf(player) * MaxLength()),
        null,
        null,
        false
    );

rule: "showParam"
Event.OngoingGlobal
{
    wm(); debugHuds[Last()] = CreateDebugHud("Server Load", ServerLoad(), IsLoadOvered() ? Color.Red : IsLoadLimited()  ? Color.Yellow : Color.Gray);
    wm(); debugHuds[Last()] = CreateDebugHud("Count Action Wait", countActionWait, Color.Gray);
    wm(); debugHuds[Last()] = CreateDebugHud("Game Speed", gameSpeed, gameSpeed < gameSpeedMax ? Color.Yellow : Color.Gray);
    wm(); debugHuds[Last()] = CreateDebugHud("Count Game Speed Decrease", countGameSpeedDecrease, countGameSpeedDecrease > 0 ? Color.Yellow : Color.Gray);
    wm(); debugHuds[Last()] = CreateDebugHud("player team player num", <"<0> / <1>", NumberOfLivingPlayers(humanTeam), NumberOfPlayers(humanTeam)>, Color.Team1);
    wm(); debugHuds[Last()] = CreateDebugHud("enemy team player num", <"<0> / <1>", NumberOfLivingPlayers(enemyTeam), NumberOfPlayers(enemyTeam)>, Color.Team2);
    wm(); debugHuds[Last()] = CreateDebugHud("killCountTeam1", killCountTeam1, Color.Team1);
    wm(); debugHuds[Last()] = CreateDebugHud("killCountTeam2", killCountTeam2, Color.Team2);
    wm(); debugHuds[Last()] = CreateDebugHud("tune Val", tuneVal, Color.Orange);
    wm(); debugHuds[Last()] = CreateDebugHud("Distance to aim pos", DistanceBetween(HostPlayer(), AimingPositonOf(HostPlayer())), Color.Orange);
    wm(); debugHuds[Last()] = CreateDebugHud("dbg Cnt A", dbgCntA, Color.Orange);
    wm(); debugHuds[Last()] = CreateDebugHud("dbg Cnt B", dbgCntB, Color.Orange);
}

