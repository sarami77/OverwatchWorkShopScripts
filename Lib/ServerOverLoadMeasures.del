import "Utility.del";

// TAG ServerOverloadMeasures/ServerLoad ----------
enum ServerLoad{
    IDLE = 50,
    LOW = 100,
    MID = 150,
    HIGH = 200,
    FULL = 255
}

// TAG ServerLoadMeasures/ServerLoadLimit ----------
define IsServerLoadLimiting() :
    ServerLoad() >= ServerLoad.HIGH ||
    ServerLoadAverage() >= ServerLoad.HIGH;

globalvar define isLoadLimiting;

rule: "ServerOverloadMeasures/setLoadLimit"
Event.OngoingGlobal
if(
    IsServerLoadLimiting()
){
    isLoadLimiting = true;
}

rule: "ServerOverloadMeasures/resetLoadLimit"
Event.OngoingGlobal
if(
    !IsServerLoadLimiting()
){
    isLoadLimiting = false;
}

// TAG ServerLoadMeasures/WaitUntilServerLoadLimitRelease ----------
define releaseGateMaxSecond : 3.0;
define releaseGateMaxNum : 100;

globalvar define countActionWait;

void WaitUntilServerLoadLimitRelease(){

    while(
        isLoadLimiting
    ){
        countActionWait ++;
        define waitTime = GetWaitTime();
        WaitUntil(!isLoadLimiting, releaseGateMaxSecond);
        Wait(waitTime , WaitBehavior.IgnoreCondition);
        countActionWait --;
    }
}

Number GetWaitTime()"GetWaitTime"{
    return
        (releaseGateMaxSecond / releaseGateMaxNum) *    // get wait time of a gate
        (countActionWait % releaseGateMaxNum);          // multi wait time by gate number
        
}

// TAG ServerLoadMeasures/GameSpeedLimiti ----------
define IsGameSpeedLimiting() :
    ServerLoad() >= ServerLoad.FULL;

define WaitTimeGameSpeedDown : 1.0;
define WaitTimeGameSpeedUp : 1.0;
define ChangeStepGameSpeedDown : 10;
define ChangeStepGameSpeedUp : 10;
define gameSpeedMax: DefaultPercentage();
globalvar define gameSpeed = gameSpeedMax;
globalvar define countGameSpeedDecrease;

rule: "ServerOverloadMeasures/GameSpeed/down"
Event.OngoingGlobal
if(
    IsGameSpeedLimiting() &&
    gameSpeed > 0
){
    Wait(WaitTimeGameSpeedDown, WaitBehavior.AbortWhenFalse);
    TuneGameSpeed(-ChangeStepGameSpeedDown);

    countGameSpeedDecrease ++;
    Loop();
}

rule: "ServerOverloadMeasures/GameSpeed/up"
Event.OngoingGlobal
if(
    !IsGameSpeedLimiting() &&
    gameSpeed < gameSpeedMax
){
    Wait(WaitTimeGameSpeedUp, WaitBehavior.AbortWhenFalse);
    TuneGameSpeed(ChangeStepGameSpeedUp);

    Loop();
}

void TuneGameSpeed(define changeVal)"TuneGameSpeed"{
    gameSpeed += changeVal;
    gameSpeed = Min(gameSpeed, gameSpeedMax);
    gameSpeed = Max(gameSpeed, 0);
    SetSlowMotion(gameSpeed);
}
