import "Utility.del";

// TAG SerServerLoadMeasures ----------
enum ServerLoad{
    IDLE = 50,
    LOW = 100,
    MID = 150,
    HIGH = 200,
    FULL = 255
}

define IsLoadLimited() :    ServerLoad() >= ServerLoad.HIGH;
define IsLoadOvered() :     ServerLoad() >= ServerLoad.FULL;

// TAG SerServerLoadMeasures/WaitUntilLoadLimitRelease ----------
define releaseGateMaxSecond : 1;
define releaseGateMaxNum : 10;
define releaseGateInterval : releaseGateMaxSecond / releaseGateMaxNum;
globalvar define countActionWait;

void WaitUntilServerLoadLimitRelease(){

    while(
        IsLoadLimited()
    ){
        countActionWait ++;

        define gateTicketNo = countActionWait % releaseGateMaxNum;
        WaitUntil(!IsLoadLimited(), 5.0);
        Wait(releaseGateInterval * gateTicketNo, WaitBehavior.IgnoreCondition);

        countActionWait --;
    }
}

// TAG ServerLoadMeasures/GameSpeed ----------
define GameSpeedDownServerLoad : ServerLoad.FULL;
define WaitTimeGameSpeedDown : 1.5;
define ChangeStepGameSpeedDown : 5;
// define WaitTimeGameSpeedUp : 1.5;

define WaitTimeGameSpeedUpForce : 3.0;
define ChangeStepGameSpeedUp : 5;

define gameSpeedMax: DefaultPercentage();
globalvar define gameSpeed = gameSpeedMax;
globalvar define countGameSpeedDecrease;

rule: "ServerOverloadMeasures/GameSpeed/down"
Event.OngoingGlobal
if(
    ServerLoad() >= GameSpeedDownServerLoad &&
    gameSpeed > 0
){
    Wait(WaitTimeGameSpeedDown, WaitBehavior.AbortWhenFalse);
    TuneGameSpeed(-ChangeStepGameSpeedDown);

    countGameSpeedDecrease ++;
    Loop();
}

// rule: "ServerOverloadMeasures/GameSpeed/up"
// Event.OngoingGlobal
// if(
//     ServerLoad() < ServerLoadOfDoGameSpeedDown &&
//     gameSpeed < gameSpeedMax
// ){
//     Wait(WaitTimeGameSpeedUp, WaitBehavior.AbortWhenFalse);
//     TuneGameSpeed(ChangeStepGameSpeedUp);

//     Loop();
// }

rule: "ServerOverloadMeasures/GameSpeed/forceUp"
Event.OngoingGlobal
if(
    // ServerLoad() < ServerLoadOfDoGameSpeedDown &&
    gameSpeed < gameSpeedMax
){
    Wait(WaitTimeGameSpeedUpForce, WaitBehavior.AbortWhenFalse);
    TuneGameSpeed(ChangeStepGameSpeedUp);

    Loop();
}

void TuneGameSpeed(define changeVal)"TuneGameSpeed"{
    gameSpeed += changeVal;
    gameSpeed = Min(gameSpeed, gameSpeedMax);
    gameSpeed = Max(gameSpeed, 0);
    SetSlowMotion(gameSpeed);
}
