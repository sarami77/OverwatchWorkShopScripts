// TAG Debug ----------
define showDebugEffect  : debugMode >= DebugMode.ShowParam;

rule: "DebugGlobalAction"
Event.OngoingGlobal
Team.All
if(
    initCompleted
){
    // teleportBasePosition icon
    CreateIcon(showDebugEffect ? hp : null,
        teleportBasePosition, Icon.ArrowDown,
        IconRev.VisibleToAndPosition, enemyTeamColor, true);
    // teleportBasePosition orb
    CreateEffect(showDebugEffect ? hp : null,
        Effect.Orb, enemyTeamColor,
        PositionOffsetY1() + teleportBasePosition,
        1, EffectRev.VisibleToPositionAndRadius);
    // teleportAreaForceUpdateSize ring
    CreateEffect(showDebugEffect ? hp : null,
        Effect.Ring, enemyTeamColor,
        teleportBasePosition,
        teleportAreaSize, EffectRev.VisibleToPositionAndRadius);

    // placeAreaBasePosition -> teleportBasePosition beam
    CreateBeamEffect(showDebugEffect ? hp : null,
        BeamType.BadBeam, 
        PositionOffsetY1() + teleportBasePosition, 
        placeAreaBasePosition,
        enemyTeamColor, EffectRev.VisibleToPositionAndRadius);
    // objectPosition -> blockedPos beam
    CreateBeamEffect((showDebugEffect && blockedPos != null )? hp : null,
        BeamType.BadBeam, 
        CurrentObjectOnPosition(), 
        blockedPos,
        Color.White, EffectRev.VisibleToPositionAndRadius);
    // placeAreaSize sphere
    CreateEffect(showDebugEffect ? hp : null,
        Effect.Sphere, Color.White,
        placeAreaBasePosition,
        placeAreaSize, EffectRev.VisibleToPositionAndRadius);

    define forceModRate = WorkshopSettingReal("Friend Bot Settings", "Force Mod Rate (when player team in disadvantage, friend bot use powerfull mod)", 1.0, 0.0, 100, 2);

    while(true){
        // auto use friend bot hero mod
        if(
            IsTrueProbability(GameProgressDiff(humanTeam) * -0.05 * forceModRate)
        ){
            define target! = 
                RandomValueInArray(
                    FilteredArray(
                        AllPlayers(humanTeam),
                        (
                            IsDummyBot(ae) &&
                            !ae.isTransformed
                        )
                    )
                );
            define mod! = GetFromLotteryList(forceParkLotteryList);
            forceHeroMod(target, mod);
        }

        // in god mod
        if(
            IsGodMode()
        ){
            // force spawn rush
            if(spawnRushInterval > 0){
                spawnRushInterval = 0;
            }

            // force hero mod to gunship
            // hp.heroModType = HeroModType.GUNSHIP_GUNNER;

            // force use gunship a frined
            if(IsTrueEverySeconds(5)){
                define target! = FirstOf(
                        SortedArray(
                            FilteredArray(
                                AllPlayers(humanTeam),
                                (
                                    IsDummyBot(ae)
                                )
                            ),
                            -SlotOf(ae)
                        )
                    );
                
                if(
                    !target.isTransformed
                ){
                    forceHeroMod(target, HeroModType.GUNSHIP_GUNNER);
                }
            }
        }

        Wait(1);
    }
}

