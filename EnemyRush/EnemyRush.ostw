define forceParkLotteryList :[
        [HeroModType.HEALING_SYRINGE,   1],
        [HeroModType.SAVIOR,            1],
        [HeroModType.POWERFUL_GIFT,     1],
        [HeroModType.SUPER_ULT,         1],
        [HeroModType.SHOT_CALL,         1],
        [HeroModType.ARTILLERY_REQUEST, 1],
        [HeroModType.STRAFING_REQUEST,  1],
        [HeroModType.GRUDGE_FIRE_BALL,  1],
        [HeroModType.GRUDGE_LIGHTNING,  1],
        [HeroModType.BEAM_SNIPER,       1],
        [HeroModType.TITAN_FORM,        1],
        [HeroModType.GUNSHIP_GUNNER,    3]
    ];

rule: "Debug/forceHeroMod"
Event.OngoingPlayer
Team.All
Player.All
if(
    HostPlayer() == ep &&
    IsButtonHeld(ep, Button.Interact) &&
    IsButtonHeld(ep, Button.PrimaryFire)
){
    // kill players on aim center
    WaitLongPressConfirm();

    define target! = 
        RandomValueInArray(
            FilteredArray(
                AllPlayers(humanTeam),
                (
                    IsDummyBot(ae) &&
                    !ae.isTransformed
                )
            )
        );
    define mod! = GetFromLotteryList(forceParkLotteryList);
    forceHeroMod(target, mod);

    LoopIfConditionIsTrue();
}

void forceHeroMod(define target, define mod)"forceHeroMod"{
    // dbgHudTxt(<"target = <0>", target>);
    // dbgHudTxt(<"mod = <0>", mod>);
    target.heroModType = mod;
    if(IsDead(target)){
        Resurrect(target);
    }
    target.grudgePower = 100;
    SetUltimateCharge(target, DefaultPercentage());
    PressButton(target, Button.Ultimate);
}

