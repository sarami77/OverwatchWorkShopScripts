// TAG EnemyBot/Mod/Fly ----------
rule: "EnemyBot/Mod/Fly"
Event.OngoingPlayer
if(
    TeamOf() == enemyTeam &&
    enemyModType == EnemyModType.Flying &&
    IsAlive()
){
    if(aimTarget != null){
        define distToTarget! = DistanceBetween(ep, aimTarget);
        define flyDir!;
        define force!;

        // front/back
        if(
            // target is close
            distToTarget < actionRangeMin
        ){
            flyDir = DirectionTowards(ep, aimTarget) * -1;
            force = actionRangeMin - distToTarget;
        }
        else if(
            // target is far
            distToTarget > actionRangeMax
        ){
            flyDir = DirectionTowards(ep, aimTarget);
            force = distToTarget - actionRangeMin;
        }

        if(
            flyDir != 0
        ){
            ApplyImpulse(ep, flyDir, force * 0.8,
                Relative.ToWorld, ContraryMotion.Cancel);
        }
    }

    Wait(1, WaitBehavior.AbortWhenFalse);
    WaitUntilServerLoadLimitRelease();
    LoopIfConditionIsTrue();
}

// TAG EnemyBot/Mod/Explode ----------
define bombScale : 
    enemyType == EnemyType.Minion ?     1 :
    enemyType == EnemyType.Elite ?      2 :
    enemyType == EnemyType.SubBoss ?    4 :
    enemyType == EnemyType.Boss ?       4 :
    0;
define bombCountDownInterval:       0.8;
define bombSize:                    bombScale * 0.4;
define bombExplodeRange:            2  + (bombScale * 3.0);
define bombExplodeDamage:           50 + (bombScale * 100);
define bombBunrningDamagePS:        25;
define bombBunrningSecond:          1 + (bombScale * 1.5);

rule: "EnemyBot/Mod/Explode"
Event.OnDeath
if(
    TeamOf() == enemyTeam &&
    enemyModType == EnemyModType.Explode
){
    define bombPos! = PositionOf() + Vector(0, 0.1, 0);
    define bombIcon! = CreateIcon(AllPlayers(humanTeam), bombPos, Icon.Warning, IconRev.VisibleToAndColor, cautionColor, true);
    define bombEfct! = CreateEffect(AllPlayers(), Effect.Sphere, cautionColor, bombPos, bombSize, EffectRev.Color);

    for(define index! = 0; index < 3; index++){
        PlayEffect(AllPlayers(), PlayEffect.RingExplosion, Color.Yellow, bombPos, bombExplodeRange * 2);
        PlayEffect(AllPlayers(), PlayEffect.DebuffImpactSound, null, bombPos, 75);
        Wait(bombCountDownInterval, WaitBehavior.IgnoreCondition);
    }

    define targets! = PlayersWithinRadius(bombPos, bombExplodeRange, Team.All, RadiusLOS.SurfacesAndAllBarriers);
    SetStatus(targets, ep, Status.Burning, bombBunrningSecond);
    ApplyBlastImpulse(targets, bombPos, bombExplodeRange, 3);
    Damage(targets, ep, bombExplodeDamage);
    StartDamageOverTime(targets, ep, bombBunrningSecond, bombBunrningDamagePS);
    PlayContinuousBlast(Color.Red, bombPos, bombExplodeRange, bombScale * 1.5, bombScale * 1.5);
    DestroyIcon(bombIcon);
    DestroyEffect(bombEfct);
}

// TAG EnemyBot/Mod/Freeze ----------
define freezeWait: 0.5;

define freezeSecond :
    enemyType == EnemyType.Minion ?     4 :
    enemyType == EnemyType.Elite ?      6 :
    enemyType == EnemyType.SubBoss ?    8 :
    enemyType == EnemyType.Boss ?       7 :
    0;

rule: "EnemyBot/Mod/Freeze"
Event.OngoingPlayer
if(
    TeamOf() == enemyTeam &&
    enemyModType == EnemyModType.Freeze &&
    IsAlive(ep) &&
    actionState == ActionState.Attack
){
    define target!;
    
    while(true){
        if(
            aimTarget != null &&
            IsAlive(aimTarget) &&
            IsOnGround(aimTarget)
        ){
            target = aimTarget;
            break;
        }
        Wait(1.0, WaitBehavior.AbortWhenFalse);
    }

    teleportPosition = target;
    PlayTeleportEffect(true, true);     // show pre teleport effect
    PlayTeleportEffect(false, true);    // show teleport effect

    define icon!;
    define effect!;
    define tryCount! = 0;

    for(tryCount = 0; tryCount < freezeSecond; tryCount++){
        if(
            !(
                IsAlive(ep) &&
                IsAlive(target) &&
                (
                    tryCount <= 0 ? 
                        IsOnGround(target) &&
                        IsInLineOfSight(EyePosition(ep), EyePosition(target))
                    :
                        DistanceBetween(ep, target) <= meleeRange * 2.0
                )
            )
        ){
            break;
        }

        teleportPosition = PositionOf(target) + (Normalize(VectorWithOutY(DirectionTowards(target, ep))) * 1.5);
        Teleport(ep, teleportPosition);
        aimTarget = target;
        PressButton(ep, Button.Melee);
        SetStatus(ep, ep, Status.Rooted, 1.1);
        SetStatus(target, ep, Status.Frozen, 1.1);

        if(!IsMoving(target)){
            SetFacing(target, DirectionTowards(EyePosition(target), EyePosition(ep)));
        }

        if(tryCount <= 0){
            icon = CreateIcon(AllPlayers(), target, Icon.ExclamationMark, IconRev.VisibleToAndColor, cautionColor, true);
            effect = CreateEffect(AllPlayers(), Effect.BadAura, Color.Blue, ep, freezeSecond / 2, EffectRev.PositionAndRadius);
        }

        Wait(1.0, WaitBehavior.IgnoreCondition);
    }
    
    DestroyIcon(icon);
    DestroyEffect(effect);
    ClearStatus(ep, Status.Frozen);
    ClearStatus(target, Status.Frozen);
    StartFacingAimTarget();
    
    Wait(3.0, WaitBehavior.AbortWhenFalse);
    LoopIfConditionIsTrue();
}

// TAG EnemyBot/EnemyAbility/SpawnRush ----------
globalvar define spawnRushInterval;
globalvar define spawnRushCount;

rule: "EnemyBot/EnemyAbility/SpawnRush"
Event.OngoingGlobal
if(
    IsGameInProgress()
){
    // set default interval by object progress
    spawnRushInterval = 60 + RandomInteger(-5, 5);
    // apply workshop setting
    spawnRushInterval *= WorkshopSettingReal("Enemy Bot Settings", "Spawn-Rush Interval Scale", 1.0, 0.0, 100, 4);
    // round for counting
    spawnRushInterval = RoundToInteger(spawnRushInterval, Rounding.Up);
    for(;spawnRushInterval > 0; spawnRushInterval--){
        Wait(1, WaitBehavior.IgnoreCondition);
    }

    // action
    define spawnRushDuration! = 20 + RandomInteger(-5, 5);
    spawnRushDuration *= WorkshopSettingReal("Enemy Bot Settings", "Spawn-Rush Duration Scale", 1.0, 0.0, 100, 5);
    define spawnInterval! = RandomInteger(1, 5);
    spawnRushCount = RoundToInteger(spawnRushDuration / spawnInterval, Rounding.Down);
    for(; spawnRushCount > 0; spawnRushCount--){
        Respawn(
            FilteredArray(
                AllDeadPlayers(enemyTeam),
                (
                    ae.enemyType != EnemyType.Boss
                )
            )
        );
        
        Wait(spawnInterval, WaitBehavior.IgnoreCondition);
    }

    Wait(1, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

// TAG EnemyBot/EnemyAbility/ShotCall ----------
globalvar define shotCallInterval;

rule: "EnemyBot/EnemyAbility/ShotCall"
Event.OngoingGlobal
if(
    IsGameInProgress()
){
    // set default interval by object progress
    shotCallInterval = 60 + RandomInteger(-5, 5);
    // apply workshop setting
    shotCallInterval *= WorkshopSettingReal("Enemy Bot Settings", "All-Out-Ultmate Interval Scale", 1.0, 0.0, 100, 6);
    // round for counting
    shotCallInterval = RoundToInteger(shotCallInterval, Rounding.Up);
    for(;shotCallInterval > 0; shotCallInterval--){
        Wait(1, WaitBehavior.IgnoreCondition);
    }

    // action
    define activeEnemys! = AllPlayers(enemyTeam);
    define shotCallDelay! = RandomReal(0.2, 1.0);
    for(define scLoopIndex! = 0; scLoopIndex < CountOf(activeEnemys); scLoopIndex ++){
        if(
            !IsInSpawnRoom(activeEnemys[scLoopIndex])
        ){
            SetUltimateCharge(activeEnemys[scLoopIndex], DefaultPercentage());
            PressButton(activeEnemys[scLoopIndex], Button.Ultimate);

            Wait(shotCallDelay, WaitBehavior.IgnoreCondition);
        }
    }

    Wait(1, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

// TAG EnemyBot/EnemyAbility/MoreUltimate ----------
define moreAbilityInterval: RandomReal(0.1, 1);

playervar define moreUltProb;

rule: "EnemyBot/EnemyAbility/moreUltimate"
Event.OngoingPlayer
if(
    TeamOf() == enemyTeam &&
    IsBossClass(ep) &&
    IsAlive() &&
    actionState != ActionState.Non &&
    IsUsingUltimate()
){
    moreUltProb = DefaultPercentage();

    while(
        IsAlive() &&
        IsTrueProbability(moreUltProb)
    ){
        WaitUntil(!IsUsingUltimate(), MaxValue());
        SetUltimateCharge(ep, DefaultPercentage());
        Wait(moreAbilityInterval, WaitBehavior.IgnoreCondition);
        PressButton(ep, Button.Ultimate);
    }
    moreUltProb = 0;

    WaitUntil(!IsUsingUltimate(), MaxValue());
    Wait(1.0, WaitBehavior.IgnoreCondition);
}

globalvar define decreaseProb! =
    WorkshopSettingReal("Enemy Bot Settings", "(Sub boss & Boss) Rapid-Fire-Ultimate Termination Scale", 1.0, 0.0, 100, 8)
        * 10.0;

rule: "EnemyBot/EnemyAbility/decreaseMultiUltimateProb"
Event.OngoingPlayer
if(
    moreUltProb > 0
){
    Wait(1.0, WaitBehavior.IgnoreCondition);
    moreUltProb -= moreUltProb < decreaseProb ? moreUltProb : decreaseProb;
    LoopIfConditionIsTrue();
}

// TAG EnemyBot/Teleport ----------
globalvar define placeAreaBasePosition;
globalvar define placeAreaSize;
define placeAreaBaseSize: ActionRange.Middle;
define placeAreaOffset: ActionRange.CanFind;   // bot can find other range

globalvar define teleportBasePosition;
define teleportAreaSize: ActionRange.Close;

globalvar define teleportCandidatePositionArray;
playervar define teleportPosition;

// TAG EnemyBot/Teleport/UpdateTeleportBasePosition ----------
globalvar define needUpdateTeleportBasePosition;
globalvar define blockedPos;

rule: "EnemyBot/Teleport/UpdateTeleportBasePosition"
Event.OngoingGlobal
if(
    IsGameInProgress()
){
    define objOnPos = CurrentObjectOnPosition();
    define clsPlyr = ClosestPlayerTo(objOnPos, humanTeam);
    define clsPlyrPos = PositionOf(clsPlyr);

    // update placeAreaBasePosition and placeAreaSize

    // for defend on path to object
    if(
        !IsTeamOnObject(humanTeam)
    ){
        // get placeAreaBasePosition by middle position of close player and object
        placeAreaBasePosition =
            ShiftedPosition(
                clsPlyrPos,
                DirectionTowards(clsPlyrPos, objOnPos),
                DistanceBetween(clsPlyrPos, objOnPos) * 0.25
            );
        // get placeAreaSize without sclae for path defend
        placeAreaSize = placeAreaBaseSize * 1.0;
    }
    else{
        // for defend on capture point
        if(
            !HasObjectDirection()
        ){
            // get placeAreaBasePosition by object position
            placeAreaBasePosition = objOnPos;
            // get placeAreaSize with sclae for point defend
            placeAreaSize = placeAreaBaseSize * 2.0;
        }
        // for defend on payload
        else{
            // get blockedPos by collision position of extension line from objectPosition 
            blockedPos = BlockedPosition(objOnPos, objectDirection, placeAreaOffset);
            // get placeAreaBasePosition by middle position of blockedPos and object
            placeAreaBasePosition = ShiftedPosition(
                objOnPos,
                DirectionTowards(objOnPos, blockedPos),
                DistanceBetween(objOnPos, blockedPos) * 0.75
            );
            // get cutoutDistance by object position and blockedPos
            define cutoutDistance! = placeAreaOffset - DistanceBetween(objOnPos, blockedPos);
            // get placeAreaSize with scale off cutoutDistance for payload
            placeAreaSize = placeAreaBaseSize + (cutoutDistance * 0.10);
        }
    }

    // if has not update flag of teleportBasePosition
    if(!needUpdateTeleportBasePosition){
        // check update condition
        if(
            // position invalid
            teleportBasePosition == null
        ){
            needUpdateTeleportBasePosition = true;
        }
        else if(
            // position count nothing
            CountOf(teleportCandidatePositionArray) <= 0
        ){
            needUpdateTeleportBasePosition = true;
        }
        else if(
            // by probability
            IsTrueProbability(3)
        ){
            needUpdateTeleportBasePosition = true;
        }
        else if(
            // position too far base position
            DistanceBetween(
                teleportBasePosition,
                placeAreaBasePosition
            ) > placeAreaSize        
        ){
            needUpdateTeleportBasePosition = true;
        }
        else if(
            // position too close player position
            DistanceBetween(
                teleportBasePosition,
                PositionOf(ClosestPlayerTo(teleportBasePosition, humanTeam))
            ) <= teleportAreaSize        
        ){
            needUpdateTeleportBasePosition = true;
        }
        else if(
            // not line from base position
            !IsInLineOfSight(
                PositionOffsetY1() + teleportBasePosition,
                PositionOffsetY1() + placeAreaBasePosition,
                BarrierLOS.NoBarriersBlock
            )
        ){
            needUpdateTeleportBasePosition = true;
        }
    }
    
    // if has update flag
    if(
        needUpdateTeleportBasePosition
    ){
        define newPosition! = null;
        // calc new position
        newPosition = GetTeleportBasePosition();

        // found position
        if(
            newPosition != null
        ){
            // update teleportBasePosition by new position
            teleportBasePosition = newPosition;
            // set teleport candidate position array by teleportBasePosition
            SetTeleportCandidatePositionArray(teleportBasePosition);
            // release update flag
            needUpdateTeleportBasePosition = false;
        }
    }

    Wait(1, WaitBehavior.IgnoreCondition);
    WaitUntilServerLoadLimitRelease();
    LoopIfConditionIsTrue();
}

define searchPositionTryCountMax: 10;
define searchPositionInterval: 0.1;

// TAG EnemyBot/Teleport/GetTeleportBasePosition
define GetTeleportBasePosition() globalvar "GetTeleportBasePosition"{
    define returnPosition = null;
    define objOnPos = CurrentObjectOnPosition();
    define clsPlyr = ClosestPlayerTo(objOnPos, humanTeam);

    for(define searchPositionTryCount = 0; searchPositionTryCount < searchPositionTryCountMax; searchPositionTryCount++){
        define candidatePosition = GetCandidatePosition(placeAreaBasePosition, placeAreaSize);
        candidatePosition = GetSnapedPosition(candidatePosition, placeAreaBaseSize * 2.0);
        if(IsValidPosition(candidatePosition, clsPlyr)){
            returnPosition = candidatePosition; 
            break;
        }

        Wait(searchPositionInterval, WaitBehavior.IgnoreCondition);
    }
        
    return returnPosition;
}

// TAG EnemyBot/Teleport/SetTeleportCandidatePositionArray
void SetTeleportCandidatePositionArray(define basePosition) globalvar "SetTeleportCandidatePositionArray"{
    teleportCandidatePositionArray = [];

    define closePlayer = ClosestPlayerTo(basePosition, humanTeam);

    for(define searchPositionTryCount = 0; searchPositionTryCount < searchPositionTryCountMax; searchPositionTryCount++){
        define candidatePosition = GetCandidatePosition(basePosition, teleportAreaSize);
        candidatePosition = GetSnapedPosition(candidatePosition, teleportAreaSize * 2.0);
        if(IsValidPosition(candidatePosition, closePlayer)){
            teleportCandidatePositionArray[CountOf(teleportCandidatePositionArray)] = candidatePosition;
        }

        Wait(searchPositionInterval, WaitBehavior.IgnoreCondition);
    }
}

// TAG EnemyBot/Teleport/GetCandidatePosition
define GetCandidatePosition(define basePosition, define randomSize) "GetCandidatePosition"{
    define candidatePosition = 
        basePosition +
        RandomPosition(
            randomSize,
            randomSize,
            randomSize
        );
    
    return candidatePosition;
}

// TAG EnemyBot/Teleport/GetSnapedPosition
define GetSnapedPosition(define inputPosition, define dropDistance)"GetSnapedPosition"{
    if(
        CanSnapMapSurface()
    ){
        inputPosition = NearestWalkablePosition(inputPosition);
    }
    else{
        inputPosition = BelowPosition(inputPosition + Vector(0, dropDistance, 0));
    }
    return inputPosition;
}

define CanSnapMapSurface()"CanSnapMapSurface"{
    // walkable position is far
    return 
    !(
        (
            CurrentMap() == Map.Kings_Row ||
            CurrentMap() == Map.Kings_Row_Winter
        )
            &&
        ObjectiveIndex() == 0
            &&
        !IsTeamOnObject(humanTeam)
    );
}

// TAG EnemyBot/Teleport/CheckCandidatePosition
define IsValidPosition(define checkPosition, define checkTarget)"CheckCandidatePosition"{
    define isValid = false;
    if(
        // not too close from spawn point
        DistanceBetween(
            checkPosition,
            SpawnPoints(humanTeam)[0]
        ) > ActionRange.Far
            &&
        // not too close from object position
        DistanceBetween(
            checkPosition,
            CurrentObjectPosition()
        ) > teleportAreaSize
            &&
        // has line to checkTarget
        IsInLineOfSight(
            PositionOffsetY1() + checkPosition,
            PositionOffsetY1() + PositionOf(checkTarget),
            BarrierLOS.NoBarriersBlock
        )
    ){
        isValid = true;
    }

    return isValid;
}


playervar define telBeam!;
define showTeleportBeamTime: 0.5;

void PlayTeleportEffect(define isBefore!, define isBeamFromBody!) playervar "PlayTeleportEffect"{
    // if before teleport
    if(isBefore){
        // show teleport beam to own position
        DestroyEffect(telBeam);

        telBeam = CreateBeamEffect(AllPlayers(),
            BeamType.BadBeam,
            isBeamFromBody ? 
                BodyPosition(ep) :
                teleportPosition + Vector(0, 30, 0),
            teleportPosition,
            enemyTeamColor, EffectRev.PositionAndRadius);
        // wait for show teleport shadow of before
        Wait(showTeleportBeamTime / 2, WaitBehavior.IgnoreCondition);

        // play teleport shadow to own position
        PlayEffect(AllPlayers(), PlayEffect.BadPickupEffect, enemyTeamColor, PositionOf(ep), 1);
        // play teleport blast to teleport positon
        PlayEffect(AllPlayers(), PlayEffect.BadExplosion, enemyTeamColor, teleportPosition, 2);

        // wait for show teleport shadow of before
        Wait(showTeleportBeamTime / 2, WaitBehavior.IgnoreCondition);
    }
    else{
        // hide teleport beam to teleport positon
        DestroyEffect(telBeam);
        // play teleport shadow to teleport positon
        PlayEffect(AllPlayers(), PlayEffect.BadPickupEffect, enemyTeamColor, PositionOf(ep), 1);
        // play teleport sound
        PlayEffect(AllPlayers(), PlayEffect.RingExplosionSound, null, PositionOf(ep), 75);
    }
}

void DoTeleport(define isBeamFromBody!, define isTeleportToOnObject!)"DoTeleport"{
    define newPosition! = null;

    // do emergency teleport as threat enemy 
    if(
        isTeleportToOnObject
    ){
        // set teleportPosition by object position
        newPosition = BlockedPosition(CurrentObjectPosition(), objectDirection, 6);
        ApplyImpulse(ep, Down(), 1, Relative.ToWorld, ContraryMotion.Cancel);
    }
    else if(CountOf(teleportCandidatePositionArray) > 0){
        // set teleportPosition by teleport candidate position array
        newPosition = RandomValueInArray(teleportCandidatePositionArray);
    }
    else{
        newPosition = teleportBasePosition;
    }

    if(
        newPosition != null
    ){
        // update teleportPosition by new position
        teleportPosition = newPosition;

        if(IsInSpawnRoom()){
            define waitTime! = 
                // set random delay for load distributing
                RandomReal(0, 1.0) *
                // scale by alive enemy team alives
                (NumberOfLivingPlayers(enemyTeam) / NumberOfPlayers(enemyTeam));
            Wait(waitTime, WaitBehavior.IgnoreCondition);
        }

        // show pre teleport effect
        PlayTeleportEffect(true, isBeamFromBody);
        // Teleport
        Teleport(ep, teleportPosition);
        // show teleport effect
        PlayTeleportEffect(false, isBeamFromBody);
    }
}

globalvar define sucideCount!;

rule: "EnemyBot/Teleport/ResetTeleportBasePosition"
Event.OnDeath
if(
    !needUpdateTeleportBasePosition &&
    TeamOf() == enemyTeam &&
    Attacker() == ep
){
    sucideCount ++;

    if(sucideCount >= 3){
        // reset by invalid position
        needUpdateTeleportBasePosition = true;
        sucideCount = 0;
    }
}

rule: "EnemyBot/Teleport/cooldownSucideCount"
Event.OngoingGlobal
if(
    sucideCount > 0
){
    Wait(1.0, WaitBehavior.IgnoreCondition);
    sucideCount --;
    LoopIfConditionIsTrue();
}

rule: "EnemyBot/Teleport/teleportByRespawn"
Event.OngoingPlayer
if(
    TeamOf() == enemyTeam &&
    IsGameInProgress() &&
    IsInSpawnRoom()
){
    DoTeleport(false, false);
    Wait(1.0, WaitBehavior.AbortWhenFalse);
    WaitUntilServerLoadLimitRelease();
    LoopIfConditionIsTrue();
}

// TAG EnemyBot/Teleport/teleportByIdleForDefendObject ----------
rule: "EnemyBot/Teleport/teleportByIdleForDefendObject"
Event.OngoingPlayer
if(
    TeamOf() == enemyTeam &&
    IsGameInProgress() &&
    !IsInSpawnRoom() &&
    IsAlive()
){
    define isFinaleDefence;

    while(true){
        Wait(3, WaitBehavior.AbortWhenFalse);
        WaitUntilServerLoadLimitRelease();

        isFinaleDefence = 
            // is boss
            IsBossClass(ep) &&
            // player team close win
            IsCloseWin(humanTeam);

        if(
            // finale
            isFinaleDefence
        ){
            // do teleport instantly
            break;
        }
        else if(
            // not in ult
            !IsUsingUltimate() &&
            // has not line to teleportBasePosition
            !IsInLineOfSight(
                PositionOffsetY1() + PositionOf(ep),
                PositionOffsetY1() + teleportBasePosition,
                BarrierLOS.NoBarriersBlock
            ) &&
            // has not line to near player
            !IsInLineOfSight(
                PositionOffsetY1() + PositionOf(ep),
                PositionOffsetY1() + PositionOf(ClosestPlayerTo(ep, humanTeam)),
                BarrierLOS.NoBarriersBlock
            )
            // // by health 
            // IsTrueProbability(
            //     DefaultPercentage() *
            //     NormalizedHealth()
            // )
        ){
            // do teleport instantly
            break;
        }
    }

    // teleport
    DoTeleport(isFinaleDefence, isFinaleDefence);
    Wait(1.0, WaitBehavior.AbortWhenFalse);
    WaitUntilServerLoadLimitRelease();
    LoopIfConditionIsTrue();
}

