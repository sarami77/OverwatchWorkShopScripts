    IsButtonHeld(ep, Button.Jump)
){
    WaitLongPressConfirm();
    SetCombatAreaPositionAtRandom();
}

rule: "Debug/reloadBotList"
Event.OngoingPlayer
Team.All
if(
    HostPlayer() == ep &&
    IsButtonHeld(ep, Button.Interact) &&
    IsButtonHeld(ep, Button.Reload)
){
