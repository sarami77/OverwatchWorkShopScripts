rule: "DebugPlayJoinPlayerSound"
Event.OnPlayerJoin
Team.All
if(
    !IsDummyBot()
){
    define soundCount! = 3;
    define positionArray! = [
        PositionOf(hp),
        SpawnPoints(Team.Team1)[0],
        combatAreaPos,
        SpawnPoints(Team.Team2)[0]
    ];

    for(define sndCount! = 0; sndCount < soundCount; sndCount++){
        for(define posIndex! = 0; posIndex < CountOf(positionArray); posIndex++){
            PlayEffect(HostPlayer(),
                PlayEffect.BuffImpactSound,
                null, positionArray[posIndex], MaxValue());
        }
        Wait(0.5);
    }
}

